# Copier ce fichier en .env.local et renseigner les valeurs
# depuis Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Uniquement pour le serveur (webhook de paiement) — jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paiement des forfaits par Lemon Squeezy (voir README, section 6).
# Tant qu'une de ces valeurs manque, le paiement en ligne reste masqué.
# Clé : Settings > API. Boutique : Settings > Stores (son numéro).
# Variantes : Products > Artisan / Pro (numéro de la variante mensuelle).
# Secret : la phrase choisie en créant le webhook (Settings > Webhooks).
LEMONSQUEEZY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_VARIANT_ARTISAN=123456
LEMONSQUEEZY_VARIANT_PRO=123457
LEMONSQUEEZY_WEBHOOK_SECRET=une-phrase-au-hasard

NEXT_PUBLIC_SITE_URL=http://localhost:3000
